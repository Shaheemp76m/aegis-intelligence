{
  "openapi": "3.0.3",
  "info": {
    "title": "Aegis Intelligence API",
    "description": "Antigravity Project Intelligence & Development Control Backend for Termux, n8n, and Gemini",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8765",
      "description": "Local Termux Daemon"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      },
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Aegis-Token"
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    },
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health Check",
        "responses": {
          "200": {
            "description": "Service health status"
          }
        }
      }
    },
    "/api/v1/projects": {
      "get": {
        "summary": "List Registered Projects",
        "responses": {
          "200": {
            "description": "List of projects"
          }
        }
      },
      "post": {
        "summary": "Register a Project",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "path"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "project_id": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Project successfully registered"
          }
        }
      }
    },
    "/api/v1/projects/{project_id}": {
      "get": {
        "summary": "Get Project Detail",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Project details"
          }
        }
      },
      "put": {
        "summary": "Update Project Metadata",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Project updated"
          }
        }
      },
      "delete": {
        "summary": "Unregister Project",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Project unregistered"
          }
        }
      }
    },
    "/api/v1/projects/{project_id}/activate": {
      "post": {
        "summary": "Set Project as Active",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Active project updated"
          }
        }
      }
    },
    "/api/v1/projects/{project_id}/inspect": {
      "post": {
        "summary": "Inspect Project Git, Filesystem, and Stack",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Inspection report"
          }
        }
      }
    },
    "/api/v1/projects/{project_id}/report": {
      "get": {
        "summary": "Generate Development Report",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "status",
                "daily",
                "weekly",
                "tasks",
                "bugs",
                "git",
                "health",
                "multi_project"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Generated Markdown report"
          }
        }
      }
    },
    "/api/v1/projects/{project_id}/tasks": {
      "get": {
        "summary": "List Tasks for Project",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "priority",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tasks list"
          }
        }
      },
      "post": {
        "summary": "Create Task",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "title"
                ],
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string"
                  },
                  "priority": {
                    "type": "string"
                  },
                  "due_date": {
                    "type": "string"
                  },
                  "notes": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Task created"
          }
        }
      }
    },
    "/api/v1/projects/{project_id}/memory": {
      "get": {
        "summary": "Search Project Memory",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "query",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Memory records"
          }
        }
      },
      "post": {
        "summary": "Store Project Memory",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "title",
                  "content"
                ],
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "content": {
                    "type": "string"
                  },
                  "category": {
                    "type": "string"
                  },
                  "source": {
                    "type": "string"
                  },
                  "confidence": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Memory recorded"
          }
        }
      }
    },
    "/api/v1/agy/execute": {
      "post": {
        "summary": "Execute Prompt via Antigravity CLI",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "prompt"
                ],
                "properties": {
                  "prompt": {
                    "type": "string"
                  },
                  "project_id": {
                    "type": "string"
                  },
                  "model": {
                    "type": "string"
                  },
                  "timeout": {
                    "type": "integer"
                  },
                  "mode": {
                    "type": "string"
                  },
                  "async": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Execution result or queued job"
          }
        }
      }
    },
    "/api/v1/agy/models": {
      "get": {
        "summary": "List Available and Active Models",
        "responses": {
          "200": {
            "description": "Verified model catalog"
          }
        }
      }
    },
    "/api/v1/agy/model/switch": {
      "post": {
        "summary": "Switch Default Model",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model"
                ],
                "properties": {
                  "model": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Model switch confirmation"
          }
        }
      }
    },
    "/api/v1/agy/usage": {
      "get": {
        "summary": "Retrieve Usage Metrics and Quota Capability Status",
        "responses": {
          "200": {
            "description": "Usage metrics"
          }
        }
      }
    },
    "/api/v1/jobs/{job_id}": {
      "get": {
        "summary": "Get Execution Job Status",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Job details"
          }
        }
      }
    },
    "/api/v1/approvals": {
      "get": {
        "summary": "List Approvals",
        "responses": {
          "200": {
            "description": "Pending and past approvals"
          }
        }
      }
    },
    "/api/v1/approvals/{approval_id}/decision": {
      "post": {
        "summary": "Submit Approval Decision",
        "parameters": [
          {
            "name": "approval_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "decision"
                ],
                "properties": {
                  "decision": {
                    "type": "string",
                    "enum": [
                      "APPROVED",
                      "REJECTED"
                    ]
                  },
                  "reason": {
                    "type": "string"
                  },
                  "actor": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Decision recorded"
          }
        }
      }
    },
    "/api/v1/tools/dispatch": {
      "post": {
        "summary": "Generic Tool Calling Endpoint for n8n AI Agent",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "tool"
                ],
                "properties": {
                  "tool": {
                    "type": "string"
                  },
                  "params": {
                    "type": "object"
                  },
                  "approval_id": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tool result"
          },
          "403": {
            "description": "Approval required gate triggered"
          }
        }
      }
    },
    "/api/v1/projects/compare": {
      "post": {
        "summary": "Compare Multiple Projects",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "project_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Array of comparative project metrics"
          }
        }
      }
    },
    "/api/v1/projects/{project_id}/context": {
      "get": {
        "summary": "Generate AI Agent Markdown Context Brief",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cohesive markdown project briefing"
          },
          "404": {
            "description": "Project not found"
          }
        }
      }
    },
    "/api/v1/projects/{project_id}/bugs": {
      "get": {
        "summary": "List Project Bugs",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "severity",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "verification_status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of bugs"
          },
          "404": {
            "description": "Project not found"
          }
        }
      },
      "post": {
        "summary": "Create Bug Record",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "title"
                ],
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "severity": {
                    "type": "string"
                  },
                  "reproduction_steps": {
                    "type": "string"
                  },
                  "affected_files": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "diagnosis": {
                    "type": "string"
                  },
                  "verification_status": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Bug created"
          },
          "404": {
            "description": "Project not found"
          }
        }
      }
    },
    "/api/v1/jobs": {
      "get": {
        "summary": "List Execution Jobs",
        "parameters": [
          {
            "name": "project_id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of execution jobs"
          }
        }
      }
    },
    "/api/v1/audit/logs": {
      "get": {
        "summary": "Query Audit Logs",
        "parameters": [
          {
            "name": "action",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of structured audit log events"
          }
        }
      }
    }
  }
}
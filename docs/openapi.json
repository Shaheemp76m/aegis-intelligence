{
  "openapi": "3.0.3",
  "info": {
    "title": "Aegis Intelligence API",
    "description": "Antigravity Project Intelligence & Development Control Backend for Termux, n8n, and Gemini",
    "version": "2.6.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8765",
      "description": "Local Termux Daemon"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      },
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Aegis-Token"
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    },
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health Check",
        "responses": {
          "200": {
            "description": "Service health status"
          }
        }
      }
    },
    "/api/v1/projects": {
      "get": {
        "summary": "List Registered Projects",
        "responses": {
          "200": {
            "description": "List of projects"
          }
        }
      },
      "post": {
        "summary": "Register a Project",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "path"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "project_id": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Project successfully registered"
          }
        }
      }
    },
    "/api/v1/projects/{project_id}": {
      "get": {
        "summary": "Get Project Detail",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Project details"
          }
        }
      },
      "put": {
        "summary": "Update Project Metadata",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Project updated"
          }
        }
      },
      "delete": {
        "summary": "Unregister Project",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Project unregistered"
          }
        }
      }
    },
    "/api/v1/projects/{project_id}/activate": {
      "post": {
        "summary": "Set Project as Active",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Active project updated"
          }
        }
      }
    },
    "/api/v1/projects/{project_id}/inspect": {
      "post": {
        "summary": "Inspect Project Git, Filesystem, and Stack",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Inspection report"
          }
        }
      }
    },
    "/api/v1/projects/{project_id}/report": {
      "get": {
        "summary": "Generate Development Report",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "status",
                "daily",
                "weekly",
                "tasks",
                "bugs",
                "git",
                "health",
                "multi_project"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Generated Markdown report"
          }
        }
      }
    },
    "/api/v1/projects/{project_id}/tasks": {
      "get": {
        "summary": "List Tasks for Project",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "priority",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tasks list"
          }
        }
      },
      "post": {
        "summary": "Create Task",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "title"
                ],
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string"
                  },
                  "priority": {
                    "type": "string"
                  },
                  "due_date": {
                    "type": "string"
                  },
                  "notes": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Task created"
          }
        }
      }
    },
    "/api/v1/projects/{project_id}/memory": {
      "get": {
        "summary": "Search Project Memory",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "query",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Memory records"
          }
        }
      },
      "post": {
        "summary": "Store Project Memory",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "title",
                  "content"
                ],
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "content": {
                    "type": "string"
                  },
                  "category": {
                    "type": "string"
                  },
                  "source": {
                    "type": "string"
                  },
                  "confidence": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Memory recorded"
          }
        }
      }
    },
    "/api/v1/agy/execute": {
      "post": {
        "summary": "Execute Prompt via Antigravity CLI",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "prompt"
                ],
                "properties": {
                  "prompt": {
                    "type": "string"
                  },
                  "project_id": {
                    "type": "string"
                  },
                  "model": {
                    "type": "string"
                  },
                  "timeout": {
                    "type": "integer"
                  },
                  "mode": {
                    "type": "string"
                  },
                  "async": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Execution result or queued job"
          }
        }
      }
    },
    "/api/v1/agy/models": {
      "get": {
        "summary": "List Available and Active Models",
        "responses": {
          "200": {
            "description": "Verified model catalog"
          }
        }
      }
    },
    "/api/v1/agy/model/switch": {
      "post": {
        "summary": "Switch Default Model",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model"
                ],
                "properties": {
                  "model": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Model switch confirmation"
          }
        }
      }
    },
    "/api/v1/agy/usage": {
      "get": {
        "summary": "Retrieve Usage Metrics and Quota Capability Status",
        "responses": {
          "200": {
            "description": "Usage metrics"
          }
        }
      }
    },
    "/api/v1/jobs/{job_id}": {
      "get": {
        "summary": "Get Execution Job Status",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Job details"
          }
        }
      }
    },
    "/api/v1/approvals": {
      "get": {
        "summary": "List Approvals",
        "responses": {
          "200": {
            "description": "Pending and past approvals"
          }
        }
      }
    },
    "/api/v1/approvals/{approval_id}/decision": {
      "post": {
        "summary": "Submit Approval Decision",
        "parameters": [
          {
            "name": "approval_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "decision"
                ],
                "properties": {
                  "decision": {
                    "type": "string",
                    "enum": [
                      "APPROVED",
                      "REJECTED"
                    ]
                  },
                  "reason": {
                    "type": "string"
                  },
                  "actor": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Decision recorded"
          }
        }
      }
    },
    "/api/v1/tools/dispatch": {
      "post": {
        "summary": "Generic Tool Calling Endpoint for n8n AI Agent",
        "description": "Unified tool dispatcher exposing 52 actions across project management, tasks, bugs, memory, git, filesystem, antigravity execution, approvals, and centralized skills.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "tool"
                ],
                "properties": {
                  "tool": {
                    "type": "string",
                    "description": "Canonical tool name or registered alias",
                    "enum": [
                      "project_register",
                      "project_list",
                      "project_get",
                      "project_update",
                      "project_delete",
                      "project_inspect",
                      "project_assessment",
                      "project_set_active",
                      "project_context",
                      "project_compare",
                      "system_health",
                      "development_health",
                      "report_generate",
                      "task_create",
                      "task_get",
                      "task_update",
                      "task_complete",
                      "task_delete",
                      "task_list",
                      "task_summary",
                      "task_overdue",
                      "bug_create",
                      "bug_get",
                      "bug_update",
                      "bug_resolve",
                      "bug_delete",
                      "bug_list",
                      "bug_summary",
                      "memory_record",
                      "memory_get",
                      "memory_update",
                      "memory_delete",
                      "memory_search",
                      "git_status",
                      "git_commits",
                      "git_diff",
                      "git_contributors",
                      "file_read",
                      "filesystem_inspect",
                      "filesystem_recent_files",
                      "agy_models_list",
                      "agy_model_switch",
                      "agy_usage_summary",
                      "agy_execute",
                      "job_list",
                      "job_get",
                      "approval_list",
                      "approval_get",
                      "approval_decide",
                      "audit_logs_get",
                      "session_get_or_create",
                      "session_add_turn",
                      "session_close",
                      "session_check_dedup",
                      "session_get",
                      "session_list",
                      "execution_progress",
                      "skill_search",
                      "skill_select",
                      "skill_inspect",
                      "skill_activate"
                    ]
                  },
                  "params": {
                    "type": "object",
                    "description": "Key-value parameters specific to the selected tool"
                  },
                  "approval_id": {
                    "type": "string",
                    "description": "Approval token required for CRITICAL or gated operations"
                  },
                  "execution_id": {
                    "type": "string",
                    "description": "Unique agent execution identifier for deduplication, progress tracking, and loop prevention"
                  },
                  "session_id": {
                    "type": "string",
                    "description": "Conversation session identifier linking execution turns"
                  },
                  "objective": {
                    "type": "string",
                    "description": "Task objective or prompt driving this execution"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tool result"
          },
          "403": {
            "description": "Approval required gate triggered"
          }
        }
      }
    },
    "/api/v1/projects/compare": {
      "post": {
        "summary": "Compare Multiple Projects",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "project_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Array of comparative project metrics"
          }
        }
      }
    },
    "/api/v1/projects/{project_id}/context": {
      "get": {
        "summary": "Generate AI Agent Markdown Context Brief",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cohesive markdown project briefing"
          },
          "404": {
            "description": "Project not found"
          }
        }
      }
    },
    "/api/v1/projects/{project_id}/assessment": {
      "get": {
        "summary": "Comprehensive Technical Assessment of a Registered Project",
        "description": "Composite read-only assessment aggregating project metadata, git status, recent commits, pending/overdue/blocked tasks, unresolved bugs, persistent memory, recently modified files, and development health.",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sections",
            "in": "query",
            "required": false,
            "description": "Comma-separated list of sections to assess: project, git, tasks, bugs, memory, filesystem, health. Defaults to all.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "execute_tests",
            "in": "query",
            "required": false,
            "description": "Whether to trigger non-destructive automated test discovery and execution as part of health assessment. Defaults to false.",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Structured project technical assessment"
          },
          "404": {
            "description": "Project not found"
          }
        }
      }
    },
    "/api/v1/projects/{project_id}/bugs": {
      "get": {
        "summary": "List Project Bugs",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "severity",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "verification_status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of bugs"
          },
          "404": {
            "description": "Project not found"
          }
        }
      },
      "post": {
        "summary": "Create Bug Record",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "title"
                ],
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "severity": {
                    "type": "string"
                  },
                  "reproduction_steps": {
                    "type": "string"
                  },
                  "affected_files": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "diagnosis": {
                    "type": "string"
                  },
                  "verification_status": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Bug created"
          },
          "404": {
            "description": "Project not found"
          }
        }
      }
    },
    "/api/v1/jobs": {
      "get": {
        "summary": "List Execution Jobs",
        "parameters": [
          {
            "name": "project_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "queued",
                "running",
                "completed",
                "failed",
                "timed_out",
                "cancelled"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 25
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of execution jobs"
          }
        }
      }
    },
    "/api/v1/audit/logs": {
      "get": {
        "summary": "Query Audit Logs",
        "parameters": [
          {
            "name": "action",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of structured audit log events"
          }
        }
      }
    },
    "/api/v1/sessions/get-or-create": {
      "post": {
        "summary": "Get or Create Conversation Session",
        "description": "Retrieve an active session or create a new session for a Telegram chat and user. Starts background typing heartbeat if new/continued.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "telegram_chat_id",
                  "telegram_user_id"
                ],
                "properties": {
                  "telegram_chat_id": {
                    "type": "string"
                  },
                  "telegram_user_id": {
                    "type": "string"
                  },
                  "message_id": {
                    "type": "string"
                  },
                  "user_prompt": {
                    "type": "string"
                  },
                  "project_id": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Session details including context history and duplication status."
          }
        }
      }
    },
    "/api/v1/sessions/add-turn": {
      "post": {
        "summary": "Add Conversation Turn to Session",
        "description": "Persist a user/agent exchange to session context history and stop the background typing indicator heartbeat.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "session_id",
                  "user_text",
                  "agent_output"
                ],
                "properties": {
                  "session_id": {
                    "type": "string"
                  },
                  "user_text": {
                    "type": "string"
                  },
                  "agent_output": {
                    "type": "string"
                  },
                  "max_turns": {
                    "type": "integer",
                    "default": 15
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated turn count and timestamp."
          }
        }
      }
    },
    "/api/v1/sessions/close": {
      "post": {
        "summary": "Close Active Conversation Session",
        "description": "Mark session completed or cancelled and terminate any active typing heartbeats.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "session_id": {
                    "type": "string"
                  },
                  "telegram_chat_id": {
                    "type": "string"
                  },
                  "telegram_user_id": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "completed",
                      "cancelled"
                    ]
                  },
                  "reason": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Number and IDs of closed sessions."
          }
        }
      }
    },
    "/api/v1/sessions/active": {
      "get": {
        "summary": "Get Active Session",
        "description": "Query active conversation session for a given chat and user ID.",
        "parameters": [
          {
            "name": "telegram_chat_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "telegram_user_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Active session object or null if none active."
          }
        }
      }
    },
    "/api/v1/sessions/typing/start": {
      "post": {
        "summary": "Start Background Telegram Typing Heartbeat",
        "description": "Spawn background thread refreshing Telegram typing indicator every 4 seconds.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "session_id",

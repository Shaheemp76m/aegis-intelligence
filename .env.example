# Aegis Intelligence Environment Configuration

# Server Binding (Must be localhost 127.0.0.1 for Termux security)
AEGIS_HOST=127.0.0.1
AEGIS_PORT=8765

# API Authentication Token (Optional: leave commented out to auto-generate data/.api_token)
# AEGIS_API_TOKEN=your_secure_random_token_here_change_me

# Antigravity CLI Settings
AGY_BIN_PATH=agy
AGY_DEFAULT_TIMEOUT=120
AGY_DEFAULT_MODEL=gemini-3.8-flash-high

# Data Storage
AEGIS_DATA_DIR=/data/data/com.termux/files/home/aegis-intelligence/data
AEGIS_DB_PATH=/data/data/com.termux/files/home/aegis-intelligence/data/aegis.db

# Approvals & Security
APPROVAL_EXPIRY_SECONDS=900
MAX_REQUEST_BODY_BYTES=5242880
LOG_LEVEL=INFO
